FROM node:22-alpine AS workspace

RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

FROM workspace AS packages
RUN pnpm --filter "./packages/*" build

FROM packages AS api
RUN pnpm --filter @refref/api build
WORKDIR /app/apps/api
CMD ["pnpm", "start"]

FROM packages AS refer
RUN pnpm --filter @refref/refer build
WORKDIR /app/apps/refer
CMD ["pnpm", "start"]

FROM packages AS webapp
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_ASSETS_URL=http://localhost:3002
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV BETTER_AUTH_SECRET=build-only-placeholder
ENV BETTER_AUTH_URL=http://localhost:3000
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_ASSETS_URL=${NEXT_PUBLIC_ASSETS_URL}
RUN pnpm --filter @refref/webapp build
WORKDIR /app/apps/webapp
CMD ["pnpm", "start"]

FROM packages AS migrate
CMD ["sh", "-c", "pnpm --filter @refref/coredb db:migrate && pnpm --filter @refref/coredb staging:margariteros"]
