---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChoiceQrClone from "../../components/ChoiceQrClone.astro";
import ConsentBanner from "../../components/ConsentBanner.astro";
import { getPage, locales, type Locale } from "../../content/page";
import { listUpcomingEvents, previewEventGroups } from "../../lib/content/events";
import { getHomepageHero } from "../../lib/content/homepage";
import { captureAttribution } from "../../lib/analytics/attribution";
import "../../styles/choiceqr-exact.css";

const requestedLocale = Astro.params.locale;
const isLocale = (value: string | undefined): value is Locale =>
  value !== undefined && locales.includes(value as Locale);
if (!isLocale(requestedLocale)) return new Response("Not found", { status: 404 });
const page = getPage(requestedLocale);
const homepage = await getHomepageHero(page.locale, Astro.locals.emdash?.getPublicMediaUrl);
const attribution = captureAttribution(Astro.url);
const now = new Date();
const previewEvents = Astro.url.searchParams.get("preview") === "events";
const liveEventGroups = previewEvents ? null : await listUpcomingEvents(page.locale, now);
const publicOrigin = process.env.PUBLIC_SITE_ORIGIN || import.meta.env.PUBLIC_SITE_ORIGIN || Astro.url.origin;
const isStaging = new URL(publicOrigin).hostname === "new.margariteros.bar";
const eventGroups = previewEvents || (isStaging && (!liveEventGroups || liveEventGroups.length === 0))
  ? previewEventGroups(now, page.locale)
  : liveEventGroups;
---
<BaseLayout {page}>
  <ChoiceQrClone {page} {homepage} {attribution} {eventGroups} />
  <ConsentBanner locale={page.locale} />
</BaseLayout>
