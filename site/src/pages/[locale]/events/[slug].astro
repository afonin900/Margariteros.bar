---
import { PortableText } from "emdash/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPage, locales, type Locale } from "../../../content/page";
import { captureAttribution, decorateOutbound } from "../../../lib/analytics/attribution";
import { getPublicEvent, localizedEvent } from "../../../lib/content/events";
import { buildEventBookingUrl, isPreviewEvent } from "../../../lib/choiceqr/event-booking";
import EventBookingButton from "../../../components/EventBookingButton.astro";

const requestedLocale = Astro.params.locale;
const slug = Astro.params.slug;
if (!requestedLocale || !locales.includes(requestedLocale as Locale) || !slug) return new Response("Not found", { status: 404 });
const locale = requestedLocale as Locale;
const page = getPage(locale);
const result = await getPublicEvent(locale, slug);
if (result.unavailable) return new Response("Service unavailable", { status: 503 });
if (!result.event) return new Response("Not found", { status: 404 });
const event = result.event;
const text = localizedEvent(event, locale);
const startsAt = new Date(event.starts_at);
const localeTag = { pl: "pl-PL", en: "en", ru: "ru", es: "es" }[locale];
const state = {
  pl: { cancelled: "Odwołane", postponed: "Przełożone", preview: "TEST — nie jest prawdziwym wydarzeniem", previewNote: "To wydarzenie pokazowe. Rezerwacja dotyczy wizyty w lokalu, a nie tego testowego wydarzenia.", booking: "Rezerwacje", generalBooking: "Ogólna rezerwacja w lokalu" },
  en: { cancelled: "Cancelled", postponed: "Postponed", preview: "TEST — not a real event", previewNote: "This is a demonstration event. The booking is for a visit to the venue, not this test event.", booking: "Booking", generalBooking: "General venue booking" },
  ru: { cancelled: "Отменено", postponed: "Перенесено", preview: "ТЕСТ — не настоящее событие", previewNote: "Это демонстрационное событие. Бронирование относится к посещению заведения, а не к этому тестовому событию.", booking: "Бронирование", generalBooking: "Общая бронь в баре" },
  es: { cancelled: "Cancelado", postponed: "Aplazado", preview: "PRUEBA — no es un evento real", previewNote: "Este es un evento de demostración. La reserva es para visitar el local, no para este evento de prueba.", booking: "Reservar", generalBooking: "Reserva general del local" },
}[locale];
const preview = isPreviewEvent(event);
const attribution = captureAttribution(Astro.url);
const bookingUrl = event.event_state === "cancelled" ? undefined : decorateOutbound(
  buildEventBookingUrl({ slug: event.slug, startsAt: event.starts_at, bookingUrl: event.booking_url, isPreview: event.isPreview, legacyPath: event.legacy_path }),
  attribution,
);
---
<BaseLayout {page}>
  <main class="event-page">
    {event.hero_image.src && <img class="hero" src={event.hero_image.src} alt={text.title} width={event.hero_image.width} height={event.hero_image.height} />}
    <article>
      {preview && <p class="state preview">{state.preview}</p>}
      {event.event_state !== "scheduled" && <p class="state">{event.event_state === "cancelled" ? state.cancelled : state.postponed}</p>}
      <time datetime={event.starts_at}>{new Intl.DateTimeFormat(localeTag, { dateStyle: "full", timeStyle: "short", timeZone: "Europe/Warsaw" }).format(startsAt)}</time>
      <h1>{text.title}</h1><p class="summary">{text.summary}</p>
      <PortableText value={text.details} />
      {preview && <p class="preview-note">{state.previewNote}</p>}
      {event.event_state !== "cancelled" && bookingUrl && (preview ? <a class="booking" href={bookingUrl} data-analytics-event="reservation_click" data-analytics-destination="booking">{state.generalBooking}</a> : <EventBookingButton {locale} title={`${state.booking}: ${text.title}`} label={state.booking} fallbackUrl={bookingUrl} startsAt={event.starts_at} bookingUrl={event.booking_url} slug={event.slug} isPreview={event.isPreview} legacyPath={event.legacy_path} {attribution} className="booking" />)}
    </article>
  </main>
</BaseLayout>
<style>
  .event-page { min-height: 100vh; background: #0b0b0b; color: #fff; }.hero { width: 100%; max-height: 60vh; object-fit: cover; }.event-page article { max-width: 760px; padding: 2rem; margin: auto; }.event-page time { color: #c6ff00; font-weight: 800; }.event-page h1 { font-size: clamp(2rem, 7vw, 4rem); line-height: .95; }.summary { font-size: 1.25rem; }.state { display: inline-block; background: #ff5a2e; color: #0b0b0b; font-weight: 800; padding: .3rem .5rem; }.state.preview { background: #fff5e1; }.preview-note { color: #cbd2b4; }.booking { display: inline-block; margin-top: 1.5rem; padding: .8rem 1rem; color: #0b0b0b; background: #c6ff00; font-weight: 800; }
</style>
