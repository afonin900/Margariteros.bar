---
<div class="cq-shell" data-choiceqr-shell>
  <div class="cq-background" aria-hidden="true"></div>
  <header class="cq-desktop-header">
    <a class="cq-brand" href={links.home} aria-label="Margariteros — wydarzenia i kuchnia w Warszawie">
      <span class="cq-logo" style="background-image:url('/media/choiceqr-brand/logo.png')"></span>
      <span><b>Margariteros — Warszawa</b><small>{page.tagline}</small></span>
    </a>
    <nav class="cq-desktop-nav" aria-label="Primary navigation">
      {copy.nav.map((label, index) => <a class:list={["cq-nav-link", { active: index === 0 }]} href={[links.home, links.menu, links.booking, links.delivery, links.feedback][index]} data-analytics-event={index === 1 ? "view_menu" : index === 2 ? "reservation_click" : undefined} data-analytics-destination={index === 1 ? "menu" : index === 2 ? "booking" : undefined}>{label}</a>)}
    </nav>
    <div class="cq-header-actions">
      <div class="cq-desktop-language"><button class="cq-button cq-language-button" type="button" data-language-open="desktop" aria-expanded="false">{page.languageCode}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><aside class="cq-language-popover" data-language-desktop hidden aria-label="Language selector"><ChoiceQrLanguageOptions locale={page.locale} /></aside></div>
      <a class="cq-button cq-icon-button" href={links.profile} aria-label="Profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2ZM12 4C16.418 4 20 7.582 20 12C20 13.5973 19.5254 15.0811 18.7188 16.3301L17.9492 15.7344C16.3972 14.5374 13.537 14 12 14C10.463 14 7.60178 14.5374 6.05078 15.7344L5.28125 16.332C4.47404 15.0828 4 13.5979 4 12C4 7.582 7.582 4 12 4ZM12 5.75C10.208 5.75 8.75 7.208 8.75 9C8.75 10.792 10.208 12.25 12 12.25C13.792 12.25 15.25 10.792 15.25 9C15.25 7.208 13.792 5.75 12 5.75ZM12 7.75C12.689 7.75 13.25 8.311 13.25 9C13.25 9.689 12.689 10.25 12 10.25C11.311 10.25 10.75 9.689 10.75 9C10.75 8.311 11.311 7.75 12 7.75ZM12 16C15.1007 16 16.7681 17.1685 17.5488 17.7539C16.11 19.1418 14.1569 20 12 20C9.84315 20 7.89002 19.1418 6.45117 17.7539C7.2319 17.1685 8.89929 16 12 16Z" fill="currentColor"/></svg></a>
      <button class="cq-button cq-icon-button" type="button" data-drawer-toggle aria-label="Menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="2" fill="currentColor"/><rect x="4" y="11" width="16" height="2" fill="currentColor"/><rect x="4" y="16" width="16" height="2" fill="currentColor"/></svg></button>
    </div>
  </header>

  <header class="cq-mobile-header">
    <div class="cq-mobile-top">
      <a class="cq-mobile-logo" href={links.home} aria-label={copy.nav[0]} style="background-image:url('/media/choiceqr-brand/logo.png')"></a>
      <div class="cq-mobile-actions">
        <button class="cq-button cq-mobile-language" type="button" data-language-open="mobile" aria-expanded="false">{page.languageCode}</button>
        <a class="cq-button cq-mobile-icon" href={links.profile} aria-label="Profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2ZM12 4C16.418 4 20 7.582 20 12C20 13.5973 19.5254 15.0811 18.7188 16.3301L17.9492 15.7344C16.3972 14.5374 13.537 14 12 14C10.463 14 7.60178 14.5374 6.05078 15.7344L5.28125 16.332C4.47404 15.0828 4 13.5979 4 12C4 7.582 7.582 4 12 4ZM12 5.75C10.208 5.75 8.75 7.208 8.75 9C8.75 10.792 10.208 12.25 12 12.25C13.792 12.25 15.25 10.792 15.25 9C15.25 7.208 13.792 5.75 12 5.75ZM12 7.75C12.689 7.75 13.25 8.311 13.25 9C13.25 9.689 12.689 10.25 12 10.25C11.311 10.25 10.75 9.689 10.75 9C10.75 8.311 11.311 7.75 12 7.75ZM12 16C15.1007 16 16.7681 17.1685 17.5488 17.7539C16.11 19.1418 14.1569 20 12 20C9.84315 20 7.89002 19.1418 6.45117 17.7539C7.2319 17.1685 8.89929 16 12 16Z" fill="currentColor"/></svg></a>
        <button class="cq-button cq-mobile-icon" type="button" data-drawer-toggle aria-label="Menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="2" fill="currentColor"/><rect x="4" y="11" width="16" height="2" fill="currentColor"/><rect x="4" y="16" width="16" height="2" fill="currentColor"/></svg></button>
      </div>
    </div>
  </header>

  <main class="cq-main">
    <section class="ad-hero" data-campaign-surface={page.locale}>
      <img src={homepage.image.src} alt={homepage.imageAlt} width={homepage.image.width} height={homepage.image.height} loading="eager" />
      <div class="ad-hero-copy"><p>{homepage.eyebrow}</p><h1>{homepage.title}</h1><span>{homepage.text}</span><div class="ad-hero-actions"><a class="primary" href={links.booking} data-analytics-event="reservation_click" data-analytics-destination="booking">{homepage.primaryCta}</a><a href={links.menu} data-analytics-event="view_menu" data-analytics-destination="menu">{homepage.secondaryCta}</a></div></div>
      <a class="ad-hero-down" href="#events-title" aria-label={homepage.galleryHeading}><i></i><i></i></a>
    </section>
    <EventCards locale={page.locale} groups={eventGroups ?? []} unavailable={eventGroups === null} {attribution} />
    <section class="ad-gallery" aria-labelledby="ad-gallery-title"><h2 id="ad-gallery-title">{homepage.galleryHeading}</h2><div>{homepage.galleryItems.map((asset) => <img src={asset.src} alt={asset.alt} width={asset.width} height={asset.height} loading="lazy" />)}</div></section>
  </main>

  <footer class="cq-footer">
    <div class="cq-footer-mobile-live">
      <section class="cq-footer-mobile-details">
        <div class="cq-footer-about"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V5l7-3 7 3v16l-7-3zM5 8l7 3 7-3M12 5v13"/></svg><div><b>{copy.about}</b><p>{copy.intro.slice(0, 94)}... <button type="button">pokaż więcej</button></p></div></div>
        <a class="cq-footer-contact-row" href={links.map} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18 0C15.791 0 14 1.791 14 4C14 6.857 18 11 18 11C18 11 22 6.857 22 4C22 1.791 20.209 0 18 0ZM18 2.57031C18.789 2.57031 19.4297 3.211 19.4297 4C19.4297 4.789 18.789 5.42969 18 5.42969C17.211 5.42969 16.5703 4.789 16.5703 4C16.5703 3.211 17.211 2.57031 18 2.57031ZM8.96875 2.93555L3.62891 5.07227C3.24891 5.22427 3 5.591 3 6V20C3 20.707 3.71409 21.1917 4.37109 20.9297L9.03125 19.0645L15.0312 21.0645L20.3711 18.9297C20.7511 18.7767 21 18.409 21 18V10.5859C20.308 11.4659 19.6965 12.1226 19.4375 12.3906L19 12.8438V17.3242L16 18.5234V11.7812C15.471 11.1873 14.716 10.2848 14 9.21484V18.6133L10 17.2812V5.38672L12.4277 6.19531C12.1657 5.46031 12 4.718 12 4C12 3.982 12.0039 3.96527 12.0039 3.94727L8.96875 2.93555ZM8 5.47656V17.3223L5 18.5234V6.67773L8 5.47656Z"/></svg><span><b>{copy.address}</b>{page.address}</span><i><svg viewBox="0 0 24 24"><path d="M8 3h13v13M21 3 10 14"/></svg></i></a>
        <a class="cq-footer-contact-row" href={page.phoneUrl}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.9883 2.00294C13.8776 2.00954 13.7655 2.02788 13.6543 2.05763L5.5957 4.21779C4.7057 4.45679 4.17897 5.37076 4.41797 6.26076L8.30273 20.7647C8.54073 21.6547 9.4557 22.1824 10.3457 21.9443L18.4023 19.7842C19.2923 19.5462 19.82 18.6312 19.582 17.7412L15.6973 3.23732C15.489 2.45857 14.7629 1.95673 13.9883 2.00294ZM14.5176 5.28029L17.5391 16.5615L9.48242 18.7217L6.46094 7.44044L14.5176 5.28029ZM20.75 5.33888L18.8184 5.85646L20.9766 13.9151L22.9082 13.3975L20.75 5.33888ZM3.02344 10.0889L1.0918 10.6065L3.25 18.6631L5.18164 18.1455L3.02344 10.0889Z"/></svg><span><b>{copy.phone}</b>{page.phoneDisplay}</span><i><svg viewBox="0 0 24 24"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z"/></svg></i></a>
        <a class="cq-footer-contact-row" href="mailto:margaritabar.pl@gmail.com"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span><b>E-mail:</b>margaritabar.pl@gmail.com</span><i><svg viewBox="0 0 24 24"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z"/></svg></i></a>
        <div class="cq-footer-contact-row cq-footer-hours"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18 12c-3.302 0-6 2.698-6 6s2.698 6 6 6 6-2.698 6-6-2.698-6-6-6Zm0 2c2.221 0 4 1.779 4 4s-1.779 4-4 4-4-1.779-4-4 1.779-4 4-4Zm.428 1.117-1.6 3.022 2.098 2.097 1.06-1.06-1.314-1.315 1.082-2.043-1.326-.7Z"/><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M2 8V6h20v2h-1.686l.378 2.464A7.988 7.988 0 0 0 18 10h.596l-.301-2H5.656l-.29 2H18a7.97 7.97 0 0 0-5.292 2H5.074l-1.021 7H2L3.639 8H2Z"/></svg><span><b>{copy.hours}</b>17:00 - 23:00 Czw</span><button type="button">Rozkład <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></button></div>
      </section>
      <section class="cq-footer-mobile-social"><h2>{copy.socials}</h2><div>{[["Instagram", links.instagram, "instagram"], ["TikTok", links.tiktok, "tiktok"], ["Google", links.google, "google"], ["TripAdvisor", links.tripadvisor, "tripadvisor"], ["Facebook", links.facebook, "facebook"]].map(([label, href, kind]) => <a href={href} target="_blank" rel="noreferrer"><svg class:list={["cq-social-icon", `cq-social-${kind}`]} viewBox="0 0 24 24" aria-hidden="true">{socialIconPaths[kind].map((d) => <path d={d} fill="currentColor"/>)}</svg>{label}</a>)}</div></section>
      <section class="cq-footer-mobile-map"><div class="cq-map-divider"></div><h2>{copy.map}</h2><div class="cq-map-frame"><iframe title="Google Maps" name="Google Maps" src="https://www.google.com/maps?q=Chmielna%207%2F9%2C%2000-021%20Warszawa%2C%20Poland&amp;z=15&amp;output=embed" width="358" height="200" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div><a class="cq-map-cta" href={links.map} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3C4.35499 3 3 4.35499 3 6C3 7.64501 4.35499 9 6 9C7.29316 9 8.39514 8.15733 8.8125 7H17C18.1167 7 19 7.88333 19 9C19 10.1167 18.1167 11 17 11H7C4.80267 11 3 12.8027 3 15V16H3.20312C3.65948 17.7064 5.15641 19 7 19H15.1875C15.6049 20.1573 16.7068 21 18 21C19.645 21 21 19.645 21 18C21 16.355 19.645 15 18 15C16.7068 15 15.6049 15.8427 15.1875 17H7C5.88333 17 5 16.1167 5 15C5 13.8833 5.88333 13 7 13H17C18.8436 13 20.3405 11.7064 20.7969 10H21V9C21 6.80267 19.1973 5 17 5H8.8125C8.39514 3.84267 7.29316 3 6 3ZM6 5C6.56413 5 7 5.43587 7 6C7 6.56413 6.56413 7 6 7C5.43587 7 5 6.56413 5 6C5 5.43587 5.43587 5 6 5ZM18 17C18.5641 17 19 17.4359 19 18C19 18.5641 18.5641 19 18 19C17.4359 19 17 18.5641 17 18C17 17.4359 17.4359 17 18 17Z" fill="currentColor"/></svg>{copy.directions}</a></section>
