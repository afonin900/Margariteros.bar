<script>
  const root = document.querySelector<HTMLElement>("[data-choiceqr-shell]");
  if (root) {
    const login = root.querySelector<HTMLAnchorElement>(".cq-login");
    const loginDescription = login?.querySelector("span");
    if (login && loginDescription) {
      const description = document.createElement("p");
      description.className = "cq-login-description";
      description.textContent = loginDescription.textContent;
      loginDescription.remove();
      login.after(description);
    }
    const drawer = root.querySelector<HTMLElement>("[data-drawer]");
    const desktopLanguage = root.querySelector<HTMLElement>("[data-language-desktop]");
    const mobileLanguage = root.querySelector<HTMLElement>("[data-language-mobile]");
    const drawerButtons = root.querySelectorAll<HTMLButtonElement>("[data-drawer-toggle]");
    const languageButtons = root.querySelectorAll<HTMLButtonElement>("[data-language-open]");
    const closeDrawer = () => { drawer?.setAttribute("hidden", ""); document.documentElement.classList.remove("cq-scroll-lock"); drawerButtons.forEach((button) => button.setAttribute("aria-expanded", "false")); };
    drawerButtons.forEach((button) => button.addEventListener("click", () => { const opening = drawer?.hasAttribute("hidden"); if (opening) { drawer?.removeAttribute("hidden"); document.documentElement.classList.add("cq-scroll-lock"); drawerButtons.forEach((candidate) => candidate.setAttribute("aria-expanded", "true")); } else closeDrawer(); }));
    const closeLanguages = () => { desktopLanguage?.setAttribute("hidden", ""); mobileLanguage?.setAttribute("hidden", ""); languageButtons.forEach((button) => button.setAttribute("aria-expanded", "false")); };
    languageButtons.forEach((button) => button.addEventListener("click", (event) => { event.stopPropagation(); const panel = button.dataset.languageOpen === "desktop" ? desktopLanguage : mobileLanguage; const opening = panel?.hasAttribute("hidden"); closeLanguages(); if (opening) { panel?.removeAttribute("hidden"); button.setAttribute("aria-expanded", "true"); } }));
    root.querySelector<HTMLButtonElement>("[data-overlay-back]")?.addEventListener("click", closeLanguages);
    root.querySelector<HTMLButtonElement>("[data-drawer-close]")?.addEventListener("click", closeDrawer);
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") { closeDrawer(); closeLanguages(); } });
    document.addEventListener("click", (event) => { if (!root.querySelector(".cq-desktop-language")?.contains(event.target as Node)) desktopLanguage?.setAttribute("hidden", ""); });
    root.querySelectorAll<HTMLInputElement>("[data-language-search]").forEach((input) => input.addEventListener("input", (event) => { const query = ((event.currentTarget as HTMLInputElement).value || "").toLowerCase(); input.closest(".cq-language-content")?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => link.hidden = !link.textContent?.toLowerCase().includes(query)); }));
  }
</script>
