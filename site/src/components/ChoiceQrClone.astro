---
<div class="cq-shell" data-choiceqr-shell>
  <div class="cq-background" aria-hidden="true"></div>
  <header class="cq-desktop-header">
    <a class="cq-brand" href={links.home} aria-label="Margariteros — wydarzenia i kuchnia w Warszawie">
      <span class="cq-logo" style="background-image:url('/media/choiceqr-brand/logo.png')"></span>
      <span><b>Margariteros — Warszawa</b><small>{page.tagline}</small></span>
    </a>
    <nav class="cq-desktop-nav" aria-label="Primary navigation">
      {copy.nav.map((label, index) => <a class:list={["cq-nav-link", { active: index === 0 }]} href={[links.home, links.menu, links.booking, links.delivery, links.feedback][index]} data-analytics-event={index === 1 ? "view_menu" : index === 2 ? "reservation_click" : undefined} data-analytics-destination={index === 1 ? "menu" : index === 2 ? "booking" : undefined}>{label}</a>)}
    </nav>
    <div class="cq-header-actions">
      <button class="cq-button cq-language-button" type="button" data-language-open aria-expanded="false">{page.languageCode}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
      <a class="cq-button cq-icon-button" href={links.profile} aria-label="Profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2ZM12 4C16.418 4 20 7.582 20 12C20 13.5973 19.5254 15.0811 18.7188 16.3301L17.9492 15.7344C16.3972 14.5374 13.537 14 12 14C10.463 14 7.60178 14.5374 6.05078 15.7344L5.28125 16.332C4.47404 15.0828 4 13.5979 4 12C4 7.582 7.582 4 12 4ZM12 5.75C10.208 5.75 8.75 7.208 8.75 9C8.75 10.792 10.208 12.25 12 12.25C13.792 12.25 15.25 10.792 15.25 9C15.25 7.208 13.792 5.75 12 5.75ZM12 7.75C12.689 7.75 13.25 8.311 13.25 9C13.25 9.689 12.689 10.25 12 10.25C11.311 10.25 10.75 9.689 10.75 9C10.75 8.311 11.311 7.75 12 7.75ZM12 16C15.1007 16 16.7681 17.1685 17.5488 17.7539C16.11 19.1418 14.1569 20 12 20C9.84315 20 7.89002 19.1418 6.45117 17.7539C7.2319 17.1685 8.89929 16 12 16Z" fill="currentColor"/></svg></a>
      <button class="cq-button cq-icon-button" type="button" data-drawer-toggle aria-label="Menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="2" fill="currentColor"/><rect x="4" y="11" width="16" height="2" fill="currentColor"/><rect x="4" y="16" width="16" height="2" fill="currentColor"/></svg></button>
    </div>
  </header>

  <header class="cq-mobile-header">
    <div class="cq-mobile-top">
      <a class="cq-mobile-logo" href={links.home} aria-label={copy.nav[0]} style="background-image:url('/media/choiceqr-brand/logo.png')"></a>
      <div class="cq-mobile-actions">
        <button class="cq-button cq-mobile-language" type="button" data-language-open aria-expanded="false">{page.languageCode}</button>
        <a class="cq-button cq-mobile-icon" href={links.search} aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 5 5"/></svg></a>
        <a class="cq-button cq-mobile-icon" href={links.profile} aria-label="Profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2ZM12 4C16.418 4 20 7.582 20 12C20 13.5973 19.5254 15.0811 18.7188 16.3301L17.9492 15.7344C16.3972 14.5374 13.537 14 12 14C10.463 14 7.60178 14.5374 6.05078 15.7344L5.28125 16.332C4.47404 15.0828 4 13.5979 4 12C4 7.582 7.582 4 12 4ZM12 5.75C10.208 5.75 8.75 7.208 8.75 9C8.75 10.792 10.208 12.25 12 12.25C13.792 12.25 15.25 10.792 15.25 9C15.25 7.208 13.792 5.75 12 5.75ZM12 7.75C12.689 7.75 13.25 8.311 13.25 9C13.25 9.689 12.689 10.25 12 10.25C11.311 10.25 10.75 9.689 10.75 9C10.75 8.311 11.311 7.75 12 7.75ZM12 16C15.1007 16 16.7681 17.1685 17.5488 17.7539C16.11 19.1418 14.1569 20 12 20C9.84315 20 7.89002 19.1418 6.45117 17.7539C7.2319 17.1685 8.89929 16 12 16Z" fill="currentColor"/></svg></a>
        <button class="cq-button cq-mobile-icon" type="button" data-drawer-toggle aria-label="Menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="2" fill="currentColor"/><rect x="4" y="11" width="16" height="2" fill="currentColor"/><rect x="4" y="16" width="16" height="2" fill="currentColor"/></svg></button>
      </div>
    </div>
  </header>

  <main class="cq-main">
    <section class="ad-hero" data-campaign-surface={page.locale}>
      <div class="ad-hero-copy"><p>{campaignCopy.eyebrow}</p><h1>{campaignCopy.title}</h1><span>{campaignCopy.text}</span><div class="ad-hero-actions"><a class="primary" href={links.booking} data-analytics-event="reservation_click" data-analytics-destination="booking">{campaignCopy.booking}</a><a href={links.menu} data-analytics-event="view_menu" data-analytics-destination="menu">{campaignCopy.menu}</a></div></div>
      <img src="/media/gallery/dance-floor-400.webp" alt={page.galleryAltDance} width="400" height="400" loading="eager" />
    </section>
    <EventCards locale={page.locale} groups={eventGroups ?? []} unavailable={eventGroups === null} />
    <section class="ad-gallery" aria-labelledby="ad-gallery-title"><h2 id="ad-gallery-title">{campaignCopy.photos}</h2><div>{page.galleryItems.slice(0, 4).map((asset) => <img src={asset.src} alt={asset.alt} width={asset.width} height={asset.height} loading="lazy" />)}</div></section>
  </main>

  <footer class="cq-footer">
    <div class="cq-footer-mobile-live">
      <section class="cq-footer-mobile-details">
        <div class="cq-footer-about"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V5l7-3 7 3v16l-7-3zM5 8l7 3 7-3M12 5v13"/></svg><div><b>{copy.about}</b><p>{copy.intro.slice(0, 94)}... <button type="button">pokaż więcej</button></p></div></div>
        <a class="cq-footer-contact-row" href={links.map} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.5 7-12a7 7 0 1 0-14 0c0 6.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2"/></svg><span><b>{copy.address}</b>{page.address}</span><i><svg viewBox="0 0 24 24"><path d="M8 3h13v13M21 3 10 14"/></svg></i></a>
        <a class="cq-footer-contact-row" href={page.phoneUrl}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h3l2 5-2 2c1.4 2.8 2.9 4.3 5.7 5.7l2-2 5 2v3c0 2-1.6 3-3.6 3C10.4 21.7 2.3 13.6 2.3 6.9 2.3 4.8 4 3 6 3Z"/></svg><span><b>{copy.phone}</b>{page.phoneDisplay}</span><i><svg viewBox="0 0 24 24"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z"/></svg></i></a>
        <a class="cq-footer-contact-row" href="mailto:margaritabar.pl@gmail.com"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span><b>E-mail:</b>margaritabar.pl@gmail.com</span><i><svg viewBox="0 0 24 24"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z"/></svg></i></a>
        <div class="cq-footer-contact-row cq-footer-hours"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M7 11h10"/></svg><span><b>{copy.hours}</b>17:00 - 23:00 Czw</span><button type="button">Rozkład <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></button></div>
      </section>
      <section class="cq-footer-mobile-social"><h2>{copy.socials}</h2><div>{[["Instagram", links.instagram, "instagram"], ["TikTok", links.tiktok, "tiktok"], ["Google", links.google, "google"], ["TripAdvisor", links.tripadvisor, "tripadvisor"], ["Facebook", links.facebook, "facebook"]].map(([label, href, kind]) => <a href={href} target="_blank" rel="noreferrer"><svg class:list={["cq-social-icon", `cq-social-${kind}`]} viewBox="0 0 24 24" aria-hidden="true">{socialIconPaths[kind].map((d) => <path d={d} fill="currentColor"/>)}</svg>{label}</a>)}</div></section>
      <section class="cq-footer-mobile-map"><div class="cq-map-divider"></div><h2>{copy.map}</h2><a class="cq-map-image" href={links.map} target="_blank" rel="noreferrer" aria-label={copy.directions}><img src="/media/choiceqr-map/chmielna-390.png" alt="Mapa dojazdu do Margariteros" width="358" height="200" loading="eager" /></a><a class="cq-map-cta" href={links.map} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h12v12H4zM8 8h12v12H8"/></svg>{copy.directions}</a></section>
    </div>
    <div class="cq-footer-content">
      <div class="cq-footer-details"><section><h2>{copy.contact}</h2><address>{page.address}</address><a href={page.phoneUrl} data-analytics-event="contact_click" data-analytics-destination="phone">{page.phoneDisplay}</a><a href="mailto:margaritabar.pl@gmail.com">margaritabar.pl@gmail.com</a></section><section><h2>{copy.hours}</h2><dl>{page.hours.map((hour) => <div><dt>{hour.day}</dt><dd>{hour.hours}</dd></div>)}</dl></section></div>
      <section class="cq-footer-social"><h2>{copy.socials}</h2><div>{[["Instagram", links.instagram, "instagram"], ["TikTok", links.tiktok, "tiktok"], ["Google", links.google, "google"], ["TripAdvisor", links.tripadvisor, "tripadvisor"], ["Facebook", links.facebook, "facebook"]].map(([label, href, destination]) => <a href={href} target="_blank" rel="noreferrer" data-analytics-event="contact_click" data-analytics-destination={destination}><svg viewBox="0 0 24 24" aria-hidden="true">{socialIconPaths[destination].map((d) => <path d={d} fill="currentColor"/>)}</svg>{label}</a>)}</div></section>
      <section class="cq-footer-map"><h2>{copy.map}</h2><a class="cq-map-image" href={links.map} target="_blank" rel="noreferrer" aria-label={copy.directions} data-analytics-event="contact_click" data-analytics-destination="map"><img src="/media/choiceqr-map/chmielna-390.png" alt="Mapa dojazdu do Margariteros" width="358" height="200" loading="lazy" /></a><a href={links.map} target="_blank" rel="noreferrer" data-analytics-event="contact_click" data-analytics-destination="map"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h12v12H4zM8 8h12v12H8"/></svg>{copy.directions}</a></section>
    </div>
  </footer>
  <div class="cq-footer-legal"><span>© 2026 Margariteros — Warszawa</span><span><a href={route("/cookie-policy")}>Cookie Policy</a><a href={route("/terms-of-use")}>Terms of Use</a><a href={route("/privacy-policy")}>Privacy Policy</a></span></div>

  <aside class="cq-language-overlay" data-language-overlay hidden aria-label="Language selector"><div class="cq-overlay-header"><button type="button" data-overlay-back aria-label="Wstecz"><svg viewBox="0 0 24 24"><path d="m14 6-6 6 6 6"/></svg></button><b>Język menu: <em>{languageNames[page.locale]}</em></b></div><div class="cq-language-content"><label><input type="search" placeholder="Wyszukiwanie języka" data-language-search /><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 5 5"/></svg></label><h2>Tłumaczone przez człowieka:</h2><div class="cq-language-group">{(["en", "pl", "ru"] as const).map((locale) => <a class:list={{selected: locale === page.locale}} href={`/${locale}/`}>{languageNames[locale]}{locale === page.locale && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="m8 12 2.5 2.5L16 9"/></svg>}</a>)}</div><h2>Tłumaczenie maszynowe:</h2><div class="cq-language-group">{machineLanguages.slice(0, 5).map((language) => <a href={language === "Spanish" ? "/es/" : `https://qr.margariteros.bar/?lang=${encodeURIComponent(language)}`}>{language}</a>)}</div><div class="cq-language-group">{machineLanguages.slice(5).map((language) => <a href={`https://qr.margariteros.bar/?lang=${encodeURIComponent(language)}`}>{language}</a>)}</div></div></aside>
  <aside class="cq-drawer" data-drawer hidden aria-label="Menu"><button class="cq-drawer-close" type="button" data-drawer-close aria-label="Zamknij"><svg viewBox="0 0 16 16"><path fill="currentColor" d="M3.293 2.293a1 1 0 0 1 1.414 0L8 5.586l3.293-3.293a1 1 0 1 1 1.414 1.414L9.414 7l3.293 3.293a1 1 0 0 1-1.414 1.414L8 8.414l-3.293 3.293a1 1 0 0 1-1.414-1.414L6.586 7 3.293 3.707a1 1 0 0 1 0-1.414Z"/></svg></button><div class="cq-drawer-inner"><a class="cq-login" href={links.profile}><i><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2ZM12 4C16.418 4 20 7.582 20 12C20 13.597 19.525 15.081 18.719 16.33L17.949 15.734C16.397 14.537 13.537 14 12 14C10.463 14 7.602 14.537 6.051 15.734L5.281 16.332C4.474 15.083 4 13.598 4 12C4 7.582 7.582 4 12 4ZM12 5.75C10.208 5.75 8.75 7.208 8.75 9C8.75 10.792 10.208 12.25 12 12.25C13.792 12.25 15.25 10.792 15.25 9C15.25 7.208 13.792 5.75 12 5.75ZM12 7.75C12.689 7.75 13.25 8.311 13.25 9C13.25 9.689 12.689 10.25 12 10.25C11.311 10.25 10.75 9.689 10.75 9C10.75 8.311 11.311 7.75 12 7.75ZM12 16C15.101 16 16.768 17.168 17.549 17.754C16.11 19.142 14.157 20 12 20C9.843 20 7.89 19.142 6.451 17.754C7.232 17.168 8.899 16 12 16Z"/></svg></i><b>{copy.login}</b><svg class="cq-row-chevron" viewBox="0 0 24 24"><path d="M9 18L15 12L9 6"/></svg><span>{copy.loginText}</span></a><section><h2>Kontakt</h2><a class="cq-drawer-row" href={links.map} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 21s7-5.5 7-12a7 7 0 1 0-14 0c0 6.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2"/></svg>{page.address}<i><svg viewBox="0 0 24 24"><path d="M8 3h13v13M21 3 10 14"/></svg></i></a><a class="cq-drawer-row" href={page.phoneUrl}><svg viewBox="0 0 24 24"><path d="M6 3h3l2 5-2 2c1.4 2.8 2.9 4.3 5.7 5.7l2-2 5 2v3c0 2-1.6 3-3.6 3C10.4 21.7 2.3 13.6 2.3 6.9 2.3 4.8 4 3 6 3Z"/></svg>{page.phoneDisplay}</a><a class="cq-drawer-row" href="mailto:margaritabar.pl@gmail.com"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>margaritabar.pl@gmail.com</a></section><section><h2>{copy.socials}</h2>{[["Instagram", links.instagram, "instagram"], ["TikTok", links.tiktok, "tiktok"], ["Google", links.google, "google"], ["TripAdvisor", links.tripadvisor, "tripadvisor"], ["Facebook", links.facebook, "facebook"]].map(([label, href, kind]) => <a class="cq-drawer-row" href={href} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24">{socialIconPaths[kind].map((d) => <path d={d} fill="currentColor"/>)}</svg>{label}<i><svg viewBox="0 0 24 24"><path d="M8 3h13v13M21 3 10 14"/></svg></i></a>)}</section><section><h2>{copy.legal}</h2>{[["Lista alergenów", route("/allergens")], ["O firmie", "https://choiceqr.com/pl"], ["Polityka plików cookie", route("/cookie-policy")], ["Regulamin", route("/terms-of-use")], ["Polityka prywatności", route("/privacy-policy")]].map(([label, href]) => <a class="cq-drawer-row" href={href}><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM15 3v5h5"/></svg>{label}<i><svg viewBox="0 0 24 24"><path d="M9 18L15 12L9 6"/></svg></i></a>)}</section></div></aside>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-choiceqr-shell]");
  if (root) {
    const login = root.querySelector<HTMLAnchorElement>(".cq-login");
    const loginDescription = login?.querySelector("span");
    if (login && loginDescription) {
      const description = document.createElement("p");
      description.className = "cq-login-description";
      description.textContent = loginDescription.textContent;
      loginDescription.remove();
      login.after(description);
    }
    const drawer = root.querySelector<HTMLElement>("[data-drawer]");
    const language = root.querySelector<HTMLElement>("[data-language-overlay]");
    const drawerButtons = root.querySelectorAll<HTMLButtonElement>("[data-drawer-toggle]");
    const languageButtons = root.querySelectorAll<HTMLButtonElement>("[data-language-open]");
    const closeDrawer = () => { drawer?.setAttribute("hidden", ""); document.documentElement.classList.remove("cq-scroll-lock"); drawerButtons.forEach((button) => button.setAttribute("aria-expanded", "false")); };
    drawerButtons.forEach((button) => button.addEventListener("click", () => { const opening = drawer?.hasAttribute("hidden"); if (opening) { drawer?.removeAttribute("hidden"); document.documentElement.classList.add("cq-scroll-lock"); drawerButtons.forEach((candidate) => candidate.setAttribute("aria-expanded", "true")); } else closeDrawer(); }));
    languageButtons.forEach((button) => button.addEventListener("click", () => { language?.removeAttribute("hidden"); button.setAttribute("aria-expanded", "true"); }));
    root.querySelector<HTMLButtonElement>("[data-overlay-back]")?.addEventListener("click", () => { language?.setAttribute("hidden", ""); languageButtons.forEach((button) => button.setAttribute("aria-expanded", "false")); });
    root.querySelector<HTMLButtonElement>("[data-drawer-close]")?.addEventListener("click", closeDrawer);
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") { closeDrawer(); language?.setAttribute("hidden", ""); languageButtons.forEach((button) => button.setAttribute("aria-expanded", "false")); } });
    root.querySelector<HTMLInputElement>("[data-language-search]")?.addEventListener("input", (event) => { const query = ((event.currentTarget as HTMLInputElement).value || "").toLowerCase(); language?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => link.hidden = !link.textContent?.toLowerCase().includes(query)); });
  }
</script>
