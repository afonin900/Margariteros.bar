---
import type { PageContent } from "../content/page";
import { decorateOutbound, type Attribution } from "../lib/analytics/attribution";
interface Props { page: PageContent; attribution: Attribution }
const { page, attribution } = Astro.props;
const bookingUrl = decorateOutbound(page.bookingUrl, attribution);
---
<section class="contact-bar" aria-label={page.contactHeading}>
  <div class="contact-quickfacts">
    <div class="contact-address"><span>{page.addressLabel}</span><address>{page.address}</address><a href={page.mapUrl} data-analytics-event="contact_click" data-analytics-destination="map"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 6 5-3 6 3 5-3v15l-5 3-6-3-5 3V6Zm5-3v15m6-12v15" /></svg>{page.mapLabel}</a></div>
    <div class="contact-phone"><span>{page.phoneLabel}</span><p>{page.phoneDisplay}</p><a href={page.phoneUrl} data-analytics-event="contact_click" data-analytics-destination="phone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3H4v4c0 7.2 5.8 13 13 13h4v-3l-5-2-2 2c-3.2-1.3-5.7-3.8-7-7l2-2-2-5Z" /></svg>{page.callLabel}</a></div>
  </div>
  <a class="booking-button" href={bookingUrl} data-analytics-event="reservation_click" data-analytics-destination="booking"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v3m12-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h3v3H8z" /></svg><span>{page.bookingLabel}</span></a>
</section>
