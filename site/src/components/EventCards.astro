---
import type { Locale } from "../content/page";
import type { MonthEvents } from "../lib/content/events";

interface Props { locale: Locale; groups: MonthEvents[]; unavailable?: boolean }
const { locale, groups, unavailable = false } = Astro.props;
const copy = {
  pl: { heading: "Nadchodzące wydarzenia", cancelled: "Odwołane", postponed: "Przełożone", booking: "Rezerwacje", details: "Szczegóły", preview: "TEST — nie jest prawdziwym wydarzeniem", empty: "Nowy program pojawi się tutaj wkrótce.", unavailable: "Program jest chwilowo niedostępny. Spróbuj ponownie później." },
  en: { heading: "Upcoming events", cancelled: "Cancelled", postponed: "Postponed", booking: "Booking", details: "Details", preview: "TEST — not a real event", empty: "The new programme will appear here soon.", unavailable: "The programme is temporarily unavailable. Please try again later." },
  ru: { heading: "Ближайшие события", cancelled: "Отменено", postponed: "Перенесено", booking: "Бронирование", details: "Подробнее", preview: "ТЕСТ — не настоящее событие", empty: "Новая программа скоро появится здесь.", unavailable: "Программа временно недоступна. Попробуйте позже." },
  es: { heading: "Próximos eventos", cancelled: "Cancelado", postponed: "Aplazado", booking: "Reservar", details: "Detalles", preview: "PRUEBA — no es un evento real", empty: "El nuevo programa aparecerá aquí pronto.", unavailable: "El programa no está disponible temporalmente. Inténtalo más tarde." },
}[locale];
const localeTag = { pl: "pl-PL", en: "en", ru: "ru", es: "es" }[locale];
const local = (event: (typeof groups)[number]["events"][number]) => locale === "pl" ? { title: event.title, summary: event.summary } : { title: event[`title_${locale}` as "title_en" | "title_ru" | "title_es"]!, summary: event[`summary_${locale}` as "summary_en" | "summary_ru" | "summary_es"]! };
---
<section class="events" aria-labelledby="events-title">
  <h2 id="events-title">{copy.heading}</h2>
  {groups.length === 0 && <p class="events-empty">{unavailable ? copy.unavailable : copy.empty}</p>}
  {groups.map((group) => <section class="events-month" aria-label={new Intl.DateTimeFormat(localeTag, { month: "long", year: "numeric", timeZone: "Europe/Warsaw" }).format(group.startsAt)}>
    <h3>{new Intl.DateTimeFormat(localeTag, { month: "long", year: "numeric", timeZone: "Europe/Warsaw" }).format(group.startsAt)}</h3>
    <div class="events-list">{group.events.map((event) => {
      const text = local(event);
      const startsAt = new Date(event.starts_at);
      const isCancelled = event.event_state === "cancelled";
      return <details class:list={["event-card", { cancelled: isCancelled }]} data-event-id={event.id} data-preview-event={event.isPreview ? "true" : undefined}>
        <summary>
          {event.hero_image.src && <img src={event.hero_image.src} alt={text.title} width={event.hero_image.width} height={event.hero_image.height} loading="lazy" />}
          <div class="event-date"><b>{new Intl.DateTimeFormat(localeTag, { day: "numeric", timeZone: "Europe/Warsaw" }).format(startsAt)}</b><span>{new Intl.DateTimeFormat(localeTag, { month: "short", timeZone: "Europe/Warsaw" }).format(startsAt)}</span><time datetime={event.starts_at}>{new Intl.DateTimeFormat(localeTag, { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" }).format(startsAt)}</time></div>
          <div class="event-copy">{event.isPreview && <span class="event-state preview" title={copy.preview}>TEST</span>}{event.event_state !== "scheduled" && <span class="event-state">{isCancelled ? copy.cancelled : copy.postponed}</span>}<h4>{text.title}</h4><p>{text.summary}</p>{!event.isPreview && <b class="event-more">{copy.details}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18L15 12L9 6" /></svg></b>}</div>
        </summary>
        {!event.isPreview && <div class="event-actions"><a href={`/${locale}/events/${event.slug}/`}>{copy.details}</a>{!isCancelled && event.booking_url && <a class="event-booking" href={event.booking_url}>{copy.booking}</a>}</div>}
      </details>;
    })}</div>
  </section>)}
</section>

<style>
  .events { padding: clamp(2rem, 5vw, 4.5rem); background: #fff5e1; color: #0b0b0b; }
  .events h2, .events h3 { margin: 0; font-family: HindSiliguri, Inter, sans-serif; text-transform: uppercase; }
  .events h2 { font-size: clamp(2rem, 5vw, 4rem); line-height: .95; }
  .events h3 { margin: 1.75rem 0 .65rem; color: #596200; font-size: 1rem; }
  .events-list { display: grid; gap: 8px; }
  .events-empty { max-width: 46rem; margin: 1.5rem 0 0; font-size: 1.15rem; }
  .event-card { overflow: hidden; border: 1px solid rgba(11,11,11,.22); border-radius: 10px; background: #fff; color: #0b0b0b; }
  .event-card summary { display: grid; grid-template-columns: 144px 64px minmax(0,1fr); min-height: 112px; cursor: pointer; list-style: none; }
  .event-card summary::-webkit-details-marker { display: none; }
  .event-card img { width: 144px; height: 112px; object-fit: cover; }
  .event-date { padding: 14px 10px; background: #c6ff00; display: flex; flex-direction: column; font-weight: 800; }
  .event-date b { font-size: 2rem; line-height: .9; }.event-date span{font-size:.75rem;line-height:1}.event-date time { margin-top: auto;font-size:.8rem; }
  .event-copy { min-width:0;padding: 16px 20px; }.event-copy h4 { margin: .25rem 0; font-size: 1.375rem;line-height:1.1; }.event-copy p { margin: 0;font-size:.94rem;line-height:1.35; }.event-more { display: flex; align-items: center; gap: .35rem; margin-top: .65rem; font-size: .75rem; text-transform: uppercase; }.event-more svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
  .event-state { display: inline-block; padding: 4px 6px; background: #ff5a2e; font-weight: 800;line-height:1; }.event-state.preview { background: #0b0b0b; color: #fff5e1; font-size: .625rem; letter-spacing:.08em;text-transform: uppercase; }
  .event-actions { display: flex; justify-content: flex-end; gap: .75rem; padding: .75rem; background: #0b0b0b; }
  .event-actions a { min-width: 132px; padding: .75rem 1rem; border: 1px solid #c6ff00; color: #fff; font-weight: 800; text-align: center; }
  .event-actions .event-booking { background: #c6ff00; color: #0b0b0b; }.cancelled { opacity: .7; }.cancelled .event-date { background: #aaa; }
  @media (max-width: 767px) and (min-width: 561px) { .event-card summary{grid-template-columns:120px 56px minmax(0,1fr);min-height:104px}.event-card img{width:120px;height:104px}.event-copy{padding:12px 14px}.event-copy h4{font-size:1.2rem}.event-copy p{font-size:.875rem} }
  @media (max-width: 560px) { .events { padding: 1.5rem 1rem 2rem; }.events h2{margin-bottom:1.5rem}.events h3{margin-top:0}.event-card summary { grid-template-columns: 88px 56px minmax(0,1fr); min-height:96px; }.event-card img { display:block;width:88px;height:96px; }.event-date{padding:12px 8px}.event-date b{font-size:1.7rem}.event-copy { padding: 10px 12px; }.event-copy h4 { font-size: 1.05rem;line-height:1.15; }.event-copy p { display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size: .78rem;line-height:1.35; }.event-actions { flex-direction: column; } }
</style>
