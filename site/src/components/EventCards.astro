---
import type { Locale } from "../content/page";
import type { MonthEvents } from "../lib/content/events";
import { buildEventBookingUrl, isPreviewEvent } from "../lib/choiceqr/event-booking";
import { decorateOutbound, type Attribution } from "../lib/analytics/attribution";

interface Props { locale: Locale; groups: MonthEvents[]; unavailable?: boolean; attribution: Attribution }
const { locale, groups, unavailable = false, attribution } = Astro.props;
const copy = {
  pl: { heading: "Nadchodzące wydarzenia", cancelled: "Odwołane", postponed: "Przełożone", booking: "Zarezerwuj stolik", details: "Szczegóły", close: "Zamknij", preview: "TEST — nie jest prawdziwym wydarzeniem", previewNote: "To karta pokazowa. Rezerwacja dotyczy wizyty w lokalu, a nie tego testowego wydarzenia.", empty: "Nowy program pojawi się tutaj wkrótce.", unavailable: "Program jest chwilowo niedostępny. Spróbuj ponownie później." },
  en: { heading: "Upcoming events", cancelled: "Cancelled", postponed: "Postponed", booking: "Book a table", details: "Details", close: "Close", preview: "TEST — not a real event", previewNote: "This is a demonstration card. The booking is for a visit to the venue, not this test event.", empty: "The new programme will appear here soon.", unavailable: "The programme is temporarily unavailable. Please try again later." },
  ru: { heading: "Ближайшие события", cancelled: "Отменено", postponed: "Перенесено", booking: "Забронировать столик", details: "Подробнее", close: "Закрыть", preview: "ТЕСТ — не настоящее событие", previewNote: "Это демонстрационная карточка. Бронирование относится к посещению заведения, а не к тестовому событию.", empty: "Новая программа скоро появится здесь.", unavailable: "Программа временно недоступна. Попробуйте позже." },
  es: { heading: "Próximos eventos", cancelled: "Cancelado", postponed: "Aplazado", booking: "Reservar una mesa", details: "Detalles", close: "Cerrar", preview: "PRUEBA — no es un evento real", previewNote: "Esta es una tarjeta de muestra. La reserva es para visitar el local, no para este evento de prueba.", empty: "El nuevo programa aparecerá aquí pronto.", unavailable: "El programa no está disponible temporalmente. Inténtalo más tarde." },
}[locale];
const localeTag = { pl: "pl-PL", en: "en", ru: "ru", es: "es" }[locale];
const local = (event: (typeof groups)[number]["events"][number]) => ({ title: event.title, summary: event.summary });
---
<section class="events" aria-labelledby="events-title">
  <div class="events-inner"><h2 id="events-title">{copy.heading}</h2>
  {groups.length === 0 && <p class="events-empty">{unavailable ? copy.unavailable : copy.empty}</p>}
  {groups.map((group) => <section class="events-month" aria-label={new Intl.DateTimeFormat(localeTag, { month: "long", year: "numeric", timeZone: "Europe/Warsaw" }).format(group.startsAt)}>
    <h3>{new Intl.DateTimeFormat(localeTag, { month: "long", year: "numeric", timeZone: "Europe/Warsaw" }).format(group.startsAt)}</h3>
    <div class="events-list">{group.events.map((event) => {
      const text = local(event);
      const startsAt = new Date(event.starts_at);
      const isCancelled = event.event_state === "cancelled";
      const preview = isPreviewEvent(event);
      const dialogId = `event-dialog-${event.id}`;
      const bookingUrl = decorateOutbound(buildEventBookingUrl({ slug: event.slug, startsAt: event.starts_at, bookingUrl: event.booking_url, isPreview: event.isPreview, legacyPath: event.legacy_path }), attribution);
      return <><article class:list={["event-card", { cancelled: isCancelled }]} data-event-id={event.id} data-preview-event={preview ? "true" : undefined}>
        <div class="event-card-row">
          {event.hero_image.src && <img src={event.hero_image.src} alt="" width={event.hero_image.width} height={event.hero_image.height} loading="lazy" />}
          <div class="event-date"><b>{new Intl.DateTimeFormat(localeTag, { day: "numeric", timeZone: "Europe/Warsaw" }).format(startsAt)}</b><span>{new Intl.DateTimeFormat(localeTag, { month: "short", timeZone: "Europe/Warsaw" }).format(startsAt)}</span><time datetime={event.starts_at}>{new Intl.DateTimeFormat(localeTag, { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" }).format(startsAt)}</time></div>
          <div class="event-copy"><div class="event-copy-main">{preview && <span class="event-state preview" title={copy.preview}>TEST</span>}{event.event_state !== "scheduled" && <span class="event-state">{isCancelled ? copy.cancelled : copy.postponed}</span>}<h4>{text.title}</h4><p>{text.summary}</p></div><button class="event-more" type="button" data-event-dialog-open={dialogId} aria-label={`${copy.details}: ${text.title}`}>{copy.details}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18L15 12L9 6" /></svg></button></div>
        </div>
      </article><dialog class="event-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}><button class="event-dialog-close" type="button" data-event-dialog-close aria-label={copy.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button><div class="event-dialog-media">{event.hero_image.src && <img src={event.hero_image.src} alt="" width={event.hero_image.width} height={event.hero_image.height} loading="lazy" />}<div class="event-dialog-date"><b>{new Intl.DateTimeFormat(localeTag, { day: "numeric", month: "long", timeZone: "Europe/Warsaw" }).format(startsAt)}</b><time datetime={event.starts_at}>{new Intl.DateTimeFormat(localeTag, { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" }).format(startsAt)}</time></div></div><div class="event-dialog-copy">{preview && <span class="event-state preview">{copy.preview}</span>}<h3 id={`${dialogId}-title`}>{text.title}</h3><p>{text.summary}</p>{preview && <p class="event-preview-note">{copy.previewNote}</p>}<a class="event-booking" href={bookingUrl} data-analytics-event="reservation_click" data-analytics-destination="booking">{copy.booking}</a></div></dialog></>;
    })}</div>
  </section>)}</div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-event-dialog-open]").forEach((button) => button.addEventListener("click", () => (document.getElementById(button.dataset.eventDialogOpen || "") as HTMLDialogElement | null)?.showModal()));
  document.querySelectorAll<HTMLDialogElement>(".event-dialog").forEach((dialog) => {
    dialog.querySelector("[data-event-dialog-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>

<style>
  .events { padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 3.5rem); background: #fff5e1; color: #0b0b0b; }
  .events-inner { width: min(100%, 1168px); margin-inline: auto; }
  .events h2, .events h3 { margin: 0; font-family: HindSiliguri, Inter, sans-serif; text-transform: uppercase; }
  .events h2 { font-size: clamp(2rem, 5vw, 4rem); line-height: .95; }
  .events h3 { margin: 1.75rem 0 .65rem; color: #596200; font-size: 1rem; }
  .events-list { display: grid; gap: 8px; }
  .events-empty { max-width: 46rem; margin: 1.5rem 0 0; font-size: 1.15rem; }
  .event-card { overflow: hidden; border: 1px solid rgba(11,11,11,.22); border-radius: 10px; background: #fff; color: #0b0b0b; }
  .event-card-row { display:grid;grid-template-columns:168px 104px minmax(0,1fr);min-height:136px }
  .event-card img { display:block;width:168px;height:100%;min-height:136px;object-fit:cover }
  .event-date { padding:18px 16px;background:#c6ff00;display:flex;align-items:flex-start;justify-content:center;flex-direction:column;font-weight:800;font-variant-numeric:tabular-nums }
  .event-date b { font-size:2.5rem;line-height:.8 }.event-date span{margin-top:6px;font-size:.8rem;line-height:1;text-transform:uppercase}.event-date time { margin-top:14px;font-size:1rem;line-height:1 }
  .event-copy { min-width:0;padding:20px 20px 20px 24px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:center }.event-copy-main{min-width:0}.event-copy h4 { margin:.35rem 0;font-size:1.375rem;line-height:1.1 }.event-copy p { max-width:58ch;margin:0;font-size:.94rem;line-height:1.35 }.event-more { display:flex;min-width:136px;min-height:48px;padding:0 16px;align-items:center;justify-content:center;gap:.35rem;border:1px solid #6d7c25;border-radius:8px;background:#fff;color:#243000;font:inherit;font-size:.75rem;font-weight:800;text-transform:uppercase;cursor:pointer;transition:background-color .2s ease-out,border-color .2s ease-out }.event-more:hover{border-color:#0b0b0b;background:#c6ff00}.event-more:focus-visible{outline:3px solid #0b0b0b;outline-offset:3px}.event-more svg { width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2 }
  .event-state { display: inline-block; padding: 4px 6px; background: #ff5a2e; font-weight: 800;line-height:1; }.event-state.preview { background: #0b0b0b; color: #fff5e1; font-size: .625rem; letter-spacing:.08em;text-transform: uppercase; }
  .cancelled { opacity: .7; }.cancelled .event-date { background: #aaa; }
  .event-dialog{width:min(680px,calc(100% - 32px));max-height:min(760px,calc(100dvh - 32px));padding:0;overflow:auto;border:1px solid #c6ff00;border-radius:12px;background:#0b0b0b;color:#fff5e1;box-shadow:0 24px 80px rgba(0,0,0,.48)}.event-dialog::backdrop{background:rgba(0,0,0,.78)}.event-dialog-close{position:absolute;z-index:2;top:12px;right:12px;display:grid;width:44px;height:44px;padding:0;place-items:center;border:1px solid #c6ff00;border-radius:8px;background:#0b0b0b;color:#fff;cursor:pointer}.event-dialog-close svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2}.event-dialog-media{position:relative}.event-dialog-media img{display:block;width:100%;height:260px;object-fit:cover}.event-dialog-date{position:absolute;left:16px;bottom:16px;display:flex;gap:12px;align-items:center;padding:10px 14px;background:#c6ff00;color:#0b0b0b;font-weight:800}.event-dialog-copy{padding:24px}.event-dialog-copy h3{margin:12px 0 8px;font-size:clamp(1.75rem,5vw,2.5rem);line-height:1}.event-dialog-copy p{max-width:65ch;margin:0 0 20px;line-height:1.5}.event-preview-note{color:#cbd2b4}.event-booking{display:inline-flex;min-height:48px;padding:0 20px;align-items:center;justify-content:center;border-radius:8px;background:#c6ff00;color:#0b0b0b;font-weight:800}.event-booking:hover{filter:brightness(1.06)}
  @media (max-width: 900px) and (min-width: 561px) { .event-card-row{grid-template-columns:132px 88px minmax(0,1fr);min-height:124px}.event-card img{width:132px;min-height:124px}.event-date{padding:14px 12px}.event-date b{font-size:2.1rem}.event-date time{margin-top:10px}.event-copy{padding:14px;gap:12px}.event-copy h4{font-size:1.2rem}.event-copy p{font-size:.875rem}.event-more{min-width:112px;padding-inline:12px} }
  @media (max-width: 560px) { .events { padding:1.5rem 1rem 2rem }.events h2{margin-bottom:1.5rem}.events h3{margin-top:0}.event-card-row { grid-template-columns:104px minmax(0,1fr);grid-template-rows:auto 1fr;min-height:156px }.event-card img { grid-column:1;grid-row:1 / 3;width:104px;min-height:156px }.event-date{grid-column:2;grid-row:1;min-height:34px;padding:8px 12px;justify-content:flex-start;flex-direction:row;align-items:baseline;gap:5px}.event-date b{font-size:1.2rem;line-height:1}.event-date span{margin:0;font-size:.7rem}.event-date span::after{content:" ·"}.event-date time{margin:0;font-size:.8rem}.event-copy { grid-column:2;grid-row:2;display:flex;padding:10px 12px 12px;gap:6px;align-items:flex-start;flex-direction:column }.event-copy h4 { margin:.25rem 0;font-size:1.08rem;line-height:1.12 }.event-copy p { display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:.78rem;line-height:1.3}.event-more{min-width:0;min-height:44px;margin-top:auto;padding:0;border:0;background:transparent}.event-more:hover{background:transparent;text-decoration:underline}.event-dialog-media img{height:210px}.event-dialog-copy{padding:20px 16px 24px}.event-booking{width:100%} }
</style>
