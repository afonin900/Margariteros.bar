---
import { decorateOutbound, type Attribution } from "../lib/analytics/attribution";

interface Props {
  title: string;
  label: string;
  fallbackUrl: string;
  attribution: Attribution;
  className?: string;
}

const {
  title,
  label,
  fallbackUrl,
  attribution,
  className,
} = Astro.props;
const directUrl = decorateOutbound(fallbackUrl, attribution);
---

<a
  class:list={["choiceqr-booking-fallback", className]}
  href={directUrl}
  aria-label={title}
  data-analytics-event="reservation_click"
  data-analytics-destination="booking"
>{label}</a>

<style>
  .choiceqr-booking-fallback { display:inline-flex; min-height:48px; padding:0 20px; align-items:center; justify-content:center; border:0; border-radius:8px; background:#c6ff00; color:#0b0b0b; font:inherit; font-weight:800; text-align:center; text-decoration:none; cursor:pointer; }
  .choiceqr-booking-fallback:hover { filter:brightness(1.06); }
  .choiceqr-booking-fallback:focus-visible { outline:3px solid currentColor; outline-offset:3px; }
  @media (max-width:560px) { .choiceqr-booking-fallback { width:100%; } }
</style>
