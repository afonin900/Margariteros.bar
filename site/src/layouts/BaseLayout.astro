---
import { locales, type Locale, type PageContent } from "../content/page";

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const canonicalOrigin = (import.meta.env.PUBLIC_SITE_ORIGIN ?? "https://new.margariteros.bar").replace(/\/$/, "");
const choiceQrTitle = page.locale === "pl"
  ? "Margariteros Bar - Meksykański Cocktail Bar w Centrum Warszawy - Dostawa, Odbiór osobisty, Rezerwacje"
  : page.title;
const localeTag: Record<Locale, string> = {
  pl: "pl-PL",
  en: "en",
  ru: "ru",
  es: "es",
};
---

<!doctype html>
<html lang={localeTag[page.locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{choiceQrTitle}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={`${canonicalOrigin}/${page.locale}/`} />
    {
      locales.map((locale) => (
        <link rel="alternate" hreflang={localeTag[locale]} href={`${canonicalOrigin}/${locale}/`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${canonicalOrigin}/pl/`} />
  </head>
  <body><slot /></body>
</html>

<style is:global>
  :root { color-scheme: dark; background: #000; color: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  a, button { min-height: 44px; }
  a:focus-visible, button:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  @media (max-width: 480px) { body { min-width: 0; } }
</style>
