{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "defaultLocale": "pl",
  "meta": {
    "name": "Margariteros website",
    "description": "English-first administration with native EmDash translations for homepage content and events."
  },
  "collections": [
    {
      "slug": "homepage",
      "label": "Homepage",
      "labelSingular": "Homepage version",
      "supports": ["drafts", "revisions", "preview"],
      "titleField": "name",
      "fields": [
        { "slug": "name", "label": "Internal name", "type": "string", "required": true, "defaultValue": "Main homepage" },
        { "slug": "hero_image", "label": "Hero image", "type": "image", "required": true },
        { "slug": "hero_eyebrow", "label": "Hero eyebrow", "type": "string" },
        { "slug": "hero_title", "label": "Hero title", "type": "string" },
        { "slug": "hero_text", "label": "Hero text", "type": "text" },
        { "slug": "hero_image_alt", "label": "Hero image description", "type": "string" },
        { "slug": "primary_cta_label", "label": "Primary button", "type": "string" },
        { "slug": "secondary_cta_label", "label": "Secondary button", "type": "string" },
        { "slug": "gallery_heading", "label": "Gallery heading", "type": "string" },
        {
          "slug": "gallery_items",
          "label": "Homepage gallery",
          "type": "repeater",
          "required": true,
          "validation": {
            "minItems": 4,
            "maxItems": 20,
            "subFields": [
              { "slug": "image", "label": "Image", "type": "image", "required": true },
              { "slug": "alt", "label": "Alt text", "type": "string", "required": true }
            ]
          }
        }
      ]
    },
    {
      "slug": "events",
      "label": "Events",
      "labelSingular": "Event",
      "supports": ["drafts", "revisions", "preview", "scheduling"],
      "titleField": "title",
      "dateField": "starts_at",
      "fields": [
        { "slug": "starts_at", "label": "Start date and time", "type": "datetime", "required": true, "indexed": true },
        { "slug": "ends_at", "label": "End date and time", "type": "datetime" },
        { "slug": "event_state", "label": "Event status", "type": "select", "required": true, "indexed": true, "defaultValue": "scheduled", "validation": { "options": ["scheduled", "postponed", "cancelled"] } },
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "summary", "label": "Card summary", "type": "text", "required": true },
        { "slug": "details", "label": "Full description", "type": "portableText", "required": true },
        { "slug": "hero_image", "label": "Event image", "type": "image", "required": true },
        { "slug": "booking_url", "label": "Booking URL", "type": "url", "defaultValue": "https://qr.margariteros.bar/booking" },
        { "slug": "fact_sources", "label": "Fact sources", "type": "text", "required": true },
        { "slug": "facts_confirmed_at", "label": "Facts confirmed at", "type": "datetime", "required": true },
        { "slug": "legacy_path", "label": "Legacy source path", "type": "string", "unique": true }
      ]
    }
  ]
}
