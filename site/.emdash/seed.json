{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Margariteros website",
    "description": "English-first administration for multilingual homepage content and events."
  },
  "collections": [
    {
      "slug": "homepage",
      "label": "Homepage",
      "labelSingular": "Homepage version",
      "supports": ["drafts", "revisions", "preview"],
      "titleField": "name",
      "fields": [
        { "slug": "name", "label": "Internal name", "type": "string", "required": true, "defaultValue": "Main homepage" },
        { "slug": "hero_image", "label": "Hero image", "type": "image", "required": true },
        { "slug": "published_locales", "label": "Ready languages", "type": "multiSelect", "required": true, "validation": { "options": ["pl", "en", "ru", "es"] } },
        { "slug": "hero_eyebrow_pl", "label": "Hero eyebrow — Polish", "type": "string" },
        { "slug": "hero_title_pl", "label": "Hero title — Polish", "type": "string" },
        { "slug": "hero_text_pl", "label": "Hero text — Polish", "type": "text" },
        { "slug": "hero_image_alt_pl", "label": "Hero image description — Polish", "type": "string" },
        { "slug": "primary_cta_label_pl", "label": "Primary button — Polish", "type": "string" },
        { "slug": "secondary_cta_label_pl", "label": "Secondary button — Polish", "type": "string" },
        { "slug": "gallery_heading_pl", "label": "Gallery heading — Polish", "type": "string" },
        { "slug": "hero_eyebrow_en", "label": "Hero eyebrow — English", "type": "string" },
        { "slug": "hero_title_en", "label": "Hero title — English", "type": "string" },
        { "slug": "hero_text_en", "label": "Hero text — English", "type": "text" },
        { "slug": "hero_image_alt_en", "label": "Hero image description — English", "type": "string" },
        { "slug": "primary_cta_label_en", "label": "Primary button — English", "type": "string" },
        { "slug": "secondary_cta_label_en", "label": "Secondary button — English", "type": "string" },
        { "slug": "gallery_heading_en", "label": "Gallery heading — English", "type": "string" },
        { "slug": "hero_eyebrow_ru", "label": "Hero eyebrow — Russian", "type": "string" },
        { "slug": "hero_title_ru", "label": "Hero title — Russian", "type": "string" },
        { "slug": "hero_text_ru", "label": "Hero text — Russian", "type": "text" },
        { "slug": "hero_image_alt_ru", "label": "Hero image description — Russian", "type": "string" },
        { "slug": "primary_cta_label_ru", "label": "Primary button — Russian", "type": "string" },
        { "slug": "secondary_cta_label_ru", "label": "Secondary button — Russian", "type": "string" },
        { "slug": "gallery_heading_ru", "label": "Gallery heading — Russian", "type": "string" },
        { "slug": "hero_eyebrow_es", "label": "Hero eyebrow — Spanish", "type": "string" },
        { "slug": "hero_title_es", "label": "Hero title — Spanish", "type": "string" },
        { "slug": "hero_text_es", "label": "Hero text — Spanish", "type": "text" },
        { "slug": "hero_image_alt_es", "label": "Hero image description — Spanish", "type": "string" },
        { "slug": "primary_cta_label_es", "label": "Primary button — Spanish", "type": "string" },
        { "slug": "secondary_cta_label_es", "label": "Secondary button — Spanish", "type": "string" },
        { "slug": "gallery_heading_es", "label": "Gallery heading — Spanish", "type": "string" }
      ]
    },
    {
      "slug": "events",
      "label": "Events",
      "labelSingular": "Event",
      "supports": ["drafts", "revisions", "preview", "scheduling"],
      "titleField": "title",
      "dateField": "starts_at",
      "fields": [
        { "slug": "starts_at", "label": "Start date and time", "type": "datetime", "required": true, "indexed": true },
        { "slug": "ends_at", "label": "End date and time", "type": "datetime" },
        { "slug": "event_state", "label": "Event status", "type": "select", "required": true, "indexed": true, "defaultValue": "scheduled", "validation": { "options": ["scheduled", "postponed", "cancelled"] } },
        { "slug": "title", "label": "Title — Polish", "type": "string", "required": true },
        { "slug": "summary", "label": "Card summary — Polish", "type": "text", "required": true },
        { "slug": "details", "label": "Full description — Polish", "type": "portableText", "required": true },
        { "slug": "title_en", "label": "Title — English", "type": "string" },
        { "slug": "summary_en", "label": "Card summary — English", "type": "text" },
        { "slug": "details_en", "label": "Full description — English", "type": "portableText" },
        { "slug": "title_ru", "label": "Title — Russian", "type": "string" },
        { "slug": "summary_ru", "label": "Card summary — Russian", "type": "text" },
        { "slug": "details_ru", "label": "Full description — Russian", "type": "portableText" },
        { "slug": "title_es", "label": "Title — Spanish", "type": "string" },
        { "slug": "summary_es", "label": "Card summary — Spanish", "type": "text" },
        { "slug": "details_es", "label": "Full description — Spanish", "type": "portableText" },
        { "slug": "published_locales", "label": "Ready languages", "type": "multiSelect", "required": true, "validation": { "options": ["pl", "en", "ru", "es"] } },
        { "slug": "hero_image", "label": "Event image", "type": "image", "required": true },
        { "slug": "booking_url", "label": "Booking URL", "type": "url", "defaultValue": "https://qr.margariteros.bar/booking" },
        { "slug": "fact_sources", "label": "Fact sources", "type": "text", "required": true },
        { "slug": "facts_confirmed_at", "label": "Facts confirmed at", "type": "datetime", "required": true },
        { "slug": "legacy_path", "label": "Legacy source path", "type": "string", "unique": true }
      ]
    }
  ]
}
